{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vanilla-love-rsvp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./rsvp-dashboard",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vanilla-love-rsvps",
      "database_id": "f1a4c635-459f-4cc7-aca9-691354c5ece6",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,https://soft-nation-dev.github.io,https://vanillalovestory.com.ng,https://www.vanillalovestory.com.ng"
  },
  "secrets": {
    "required": ["ADMIN_PASSWORD", "RSVP_HASH_SALT"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
