{
  "name": "staceys-invitation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently --kill-others-on-fail --names invitation,rsvp --prefix-colors magenta,green \"npm:dev\" \"npm:rsvp:dev\"",
    "build": "tsc -b && vite build",
    "build:worker": "tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "rsvp:dev": "wrangler dev --port 8787",
    "rsvp:types": "wrangler types",
    "rsvp:migrate:local": "wrangler d1 migrations apply vanilla-love-rsvps --local",
    "rsvp:migrate:remote": "wrangler d1 migrations apply vanilla-love-rsvps --remote",
    "rsvp:deploy": "wrangler deploy"
  },
  "dependencies": {
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@cloudflare/workers-types": "^5.20260812.1",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "wrangler": "^4.121.0"
  }
}
